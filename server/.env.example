# PP-StructureV3 网关后端环境变量示例
# 复制为 .env 并填入真实值，切勿提交 .env 到 git

AI_STUDIO_API_URL=https://aistudio.baidu.com/serving/online/v1/xxx
AI_STUDIO_ACCESS_TOKEN=<your-token-here>

# 服务配置
APP_HOST=0.0.0.0
APP_PORT=8900
APP_LOG_LEVEL=info

# AI Studio 请求超时（秒）
AI_STUDIO_TIMEOUT=60

# 最大上传文件大小（字节），默认 20MB
MAX_UPLOAD_SIZE=20971520

# 临时开发身份边界：生产环境必须设为 false，并接入可信认证上下文
APP_ENV=development
MATH_ALLOW_DEV_USER_HEADER=true

# 第五阶段 A：verified 数学工件教学讲解（默认 mock，不消耗外部额度）
MATH_EXPLANATION_PROVIDER=mock
MATH_EXPLANATION_BASE_URL=https://api.deepseek.com
MATH_EXPLANATION_API_KEY=<set-only-on-server>
MATH_EXPLANATION_MODEL=deepseek-chat
MATH_EXPLANATION_TEMPERATURE=0.1
MATH_EXPLANATION_MAX_TOKENS=1200
MATH_EXPLANATION_MAX_RETRIES=2
MATH_EXPLANATION_TOTAL_TIMEOUT=30
MATH_EXPLANATION_PRICING_VERSION=2026-08
# 留空时 estimated_cost=null；不要在代码或日志中写死价格
MATH_EXPLANATION_INPUT_PRICE_PER_MILLION=
MATH_EXPLANATION_OUTPUT_PRICE_PER_MILLION=
# 只有显式 live canary 命令才允许真实 DeepSeek 请求
MATH_EXPLANATION_LIVE_TEST=0
